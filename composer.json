{
    "name": "131studios/watchtower-agent",
    "description": "Watchtower monitoring agent for Laravel sites",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "monitoring", "observability", "logging", "watchtower"],
    "homepage": "https://github.com/robbfountain/watchtower-agent",
    "support": {
        "issues": "https://github.com/robbfountain/watchtower-agent/issues",
        "source": "https://github.com/robbfountain/watchtower-agent"
    },
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "guzzlehttp/guzzle": "^7.8",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {"Watchtower\\Agent\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Watchtower\\Agent\\Tests\\": "tests/"}
    },
    "scripts": {
        "check-version": "php bin/assert-version.php"
    },
    "extra": {
        "laravel": {"providers": ["Watchtower\\Agent\\AgentServiceProvider"]}
    },
    "config": {
        "allow-plugins": {"pestphp/pest-plugin": true}
    },
    "minimum-stability": "stable"
}
